{
  "regions": ["sin1"],
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "{public/**,admin/**}",
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/briefing",
      "schedule": "0 23 * * *"
    }
  ]
}

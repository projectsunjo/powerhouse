# 서버 포트 (로컬 개발용, Vercel에서는 무시됨)
PORT=3000

# 관리자 로그인 비밀번호 (강력한 값으로 변경하세요)
ADMIN_PASSWORD=change-me-please

# 세션/토큰 서명용 비밀키 (강력한 랜덤 문자열로 변경하세요)
JWT_SECRET=change-this-random-secret
IP_HASH_SALT=change-this-random-salt

# Supabase Postgres 연결 문자열 (Transaction pooler, 포트 6543 권장 — 서버리스 환경용)
DATABASE_URL=postgresql://user:password@host:6543/postgres

# 에너지 솔루션 브리핑 발송용 Gmail 계정 (선택). 받는 사람 목록/메일 제목은
# 관리자 대시보드 > 브리핑 관리 탭에서 설정합니다 (BRIEFING_EMAIL_TO는 최초 seed용으로만 쓰임).
GMAIL_USER=your-account@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
BRIEFING_EMAIL_TO=recipient@example.com

# "지금생성" 버튼이 GitHub Actions 워크플로를 실행시키는 데 필요 (repo/workflow 권한 PAT)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
GITHUB_REPO=owner/repo

# claude CLI 헤드리스 인증용 (GitHub Actions에서 브리핑 생성 시 필요)
# CLAUDE_CODE_OAUTH_TOKEN=

# 회사 네트워크 등 TLS 인터셉션 방화벽 뒤에서 로컬 개발할 때만 필요
# NODE_EXTRA_CA_CERTS=
